{
  "manifest_version": 3,
  "name": "restitutor",
  "version": "0.1.0",
  "description": "Restore, strip, and dimension-check the constants in equations. Lookup, never inference - the unvouched-for declines loudly.",
  "content_scripts": [
    {
      "matches": [
        "https://ar5iv.labs.arxiv.org/*",
        "https://arxiv.org/html/*",
        "https://*.wikipedia.org/*"
      ],
      "js": ["content.js"],
      "css": ["decorate.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["katex.min.css", "fonts/*"],
      "matches": [
        "https://ar5iv.labs.arxiv.org/*",
        "https://arxiv.org/*",
        "https://*.wikipedia.org/*"
      ]
    }
  ]
}
