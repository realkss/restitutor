{
  "manifest_version": 3,
  "name": "restitutor",
  "version": "0.2.0",
  "description": "Restore, strip, and dimension-check the constants in equations. Lookup, never inference - the unvouched-for declines loudly.",
  "homepage_url": "https://github.com/realkss/restitutor",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ar5iv.labs.arxiv.org/*",
        "https://arxiv.org/html/*",
        "https://*.wikipedia.org/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "decorate.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "katex.min.css",
        "fonts/*"
      ],
      "matches": [
        "https://ar5iv.labs.arxiv.org/*",
        "https://arxiv.org/*",
        "https://*.wikipedia.org/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
